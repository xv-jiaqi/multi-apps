{
  "name": "@repo/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens shared across web, native and miniapp (color, spacing, typography).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./src/tailwind.css",
    "./taro.scss": "./src/taro.scss"
  },
  "files": [
    "dist",
    "src/tailwind.css",
    "src/taro.scss"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/config-ts": "workspace:*",
    "typescript": "^6.0.3"
  }
}
