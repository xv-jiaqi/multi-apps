{
  "name": "@repo/trpc-contract",
  "version": "0.0.0",
  "private": true,
  "description": "Re-exports the AppRouter type from the API so that clients can derive end-to-end type safety without importing server code.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "^11.18.0"
  },
  "devDependencies": {
    "@cardhub/api": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "typescript": "^6.0.3"
  }
}
