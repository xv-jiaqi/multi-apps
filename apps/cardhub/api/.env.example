# Copy to .env and fill in real values.

NODE_ENV=development
PORT=4000

# Comma-separated allowlist for the Express CORS layer. Defaults cover the
# Vite dev server, the Tauri WebView (custom protocol on macOS / Linux uses
# tauri://localhost; Windows uses https://tauri.localhost), and the local Taro
# H5 build. Extend in production via the Render env group.
CORS_ORIGIN=http://localhost:5173,http://localhost:10086,tauri://localhost,https://tauri.localhost

DATABASE_URL=postgresql://cardhub:cardhub@localhost:5432/cardhub?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Sentry DSN for the API. Leave blank to skip initialisation entirely (dev
# default). When set, INTERNAL_SERVER_ERROR exceptions from both NestJS and
# tRPC are forwarded automatically.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
