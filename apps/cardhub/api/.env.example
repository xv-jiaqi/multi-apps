# Copy to .env and fill in real values.

NODE_ENV=development
PORT=4000

# Comma-separated allowlist for the Express CORS layer. Keep credentials=true
# on the API and list every Web origin that may send auth headers/cookies.
# Production: https://card-hub.app
# Staging: https://staging.card-hub.app
# Optional www prod alias: https://www.card-hub.app
CORS_ORIGIN=http://localhost:5173,http://localhost:10086,https://card-hub.app,https://staging.card-hub.app,tauri://localhost,https://tauri.localhost

DATABASE_URL=postgresql://cardhub:cardhub@localhost:5432/cardhub?schema=public
# Production migrations run in a one-shot container that reads
# MIGRATE_DATABASE_URL. The API process must not have that variable. Leave it
# unset locally. Cutover steps: deploy/db/README.md.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Only the exact string true stores sha256$ + bcrypt(base64(sha256(password))).
# 1, TRUE, yes, empty, and unset all keep writing legacy bcrypt. Verification
# of both formats does not use this flag. Staging sets true. Production stays
# false until an operator enables it.
PASSWORD_PREHASH_WRITE=false

# Required by `prisma db seed` / `seed:demo`. Leave unset in production unless
# you intentionally seed demo accounts in a non-production environment.
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Injected by Docker/CI at runtime. /health and tRPC health.ping expose these
# so deploy automation can verify the running container.
GIT_SHA=unknown
BUILD_TIME=unknown

# Sentry DSN for the API. Leave blank to skip initialisation entirely (dev
# default). When set, INTERNAL_SERVER_ERROR exceptions from both NestJS and
# tRPC are forwarded automatically. Sentry release is set to GIT_SHA.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
