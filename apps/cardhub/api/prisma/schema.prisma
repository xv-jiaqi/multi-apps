generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  // role: "user" | "admin". Admins can delete any topic / reply / listing /
  // comment and view the moderation report queue. Stored as a free-form
  // string instead of an enum so a future role ("mod") doesn't need a
  // schema migration just to be added. Ban is `bannedAt`, not a role.
  role      String   @default("user")
  // Bumped to revoke outstanding JWTs. Missing `ver` on a token counts as 0,
  // which matches this default, so applying the column does not log anyone out.
  tokenVersion Int   @default(0)
  // Set at login when a legacy bcrypt hash was checked with a password longer
  // than bcrypt's 72-byte input. Cleared after a successful password change.
  // Old servers ignore the column.
  passwordChangeRecommended Boolean @default(false)
  // Null means the account can post. Set while an admin ban is in effect.
  // Old servers ignore the column. Ban is a status, not a role.
  bannedAt   DateTime?
  bannedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments        Comment[]
  topics          Topic[]
  replies         Reply[]
  listings        Listing[]
  reportsFiled    Report[]  @relation("ReportReporter")
  reportsResolved Report[]  @relation("ReportResolver")
  auditLogsActed    AuditLog[] @relation("AuditActor")
  auditLogsTargeted AuditLog[] @relation("AuditTargetUser")
  dailyActivities   UserDailyActivity[]
  bannedBy   User?  @relation("UserBannedBy", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedUsers User[] @relation("UserBannedBy")

  @@index([bannedAt])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series Series[]

  @@index([sortOrder, name])
  @@map("categories")
}

model Series {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  coverUrl    String?
  // Null means the series is not in a category. Deleting a category sets this
  // to null and leaves the series in place. Old servers ignore the column.
  categoryId  String?
  // Calendar date, no time. Null means the release date is unknown. Old
  // servers ignore the column.
  releaseDate DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subsets  Subset[]
  cards    Card[]
  comments Comment[]

  @@index([categoryId])
  @@index([releaseDate])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "series_title_trgm_idx", type: Gin)
  @@map("series")
}

model Subset {
  id          String     @id @default(uuid())
  seriesId    String
  slug        String
  name        String
  kind        SubsetKind
  sortOrder   Int        @default(0)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cards  Card[]

  @@unique([seriesId, slug])
  @@index([seriesId, sortOrder])
  @@map("subsets")
}

model Card {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  rarity      String?
  attributes  Json?
  seriesId    String
  // Null means the card has no printed number. Old servers ignore the column.
  cardNumber  String?
  // Null means the card is not in a subset (ungrouped). Deleting a subset
  // sets this to null and leaves the card in place.
  subsetId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  subset   Subset?   @relation(fields: [subsetId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([seriesId])
  @@index([subsetId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "cards_name_trgm_idx", type: Gin)
  @@map("cards")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  cardId    String?
  seriesId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  // Null means a top-level comment. Replies point at that top-level row.
  // Expand-only: old servers ignore the column. Roll the app back first.
  // Dropping comments_parentId_createdAt_id_idx, comments_parentId_fkey,
  // comments_parentId_idx, and parentId must be a new forward migration
  // (docs/Cardhub/development-backlog.md §1.3). Do not edit a merged
  // migration. Until the column is dropped, an old list does not filter
  // parentId, so replies show up as extra top-level rows.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([cardId])
  @@index([seriesId])
  @@index([parentId])
  @@index([parentId, createdAt, id])
  @@map("comments")
}

model Topic {
  id        String    @id @default(uuid())
  // slug = slugify(title) + "-" + 6-char nanoid suffix to keep the URL stable
  // even if the author edits the title within the 5-minute window.
  slug      String    @unique
  title     String
  body      String
  userId    String
  // pinned topics float to the top of the timeline. Only admins set this in
  // M6 — there is no UI for ordinary users.
  pinned    Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@index([createdAt])
  @@index([pinned, createdAt, id])
  @@index([userId])
  @@map("topics")
}

model Reply {
  id        String   @id @default(uuid())
  topicId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@map("replies")
}

enum SubsetKind {
  BASE
  INSERT
}

enum ListingKind {
  SELL
  BUY
}

enum ListingStatus {
  OPEN
  CLOSED
}

enum ListingCondition {
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

enum ListingLanguage {
  ZH
  EN
  JA
  OTHER
}

enum ReportTargetType {
  LISTING
  TOPIC
  REPLY
  COMMENT
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model Listing {
  id          String            @id @default(uuid())
  userId      String
  // cardSlug is stored as a string instead of a Card relation because a
  // listing may reference a card slug that was reseeded / renamed; keeping
  // the link soft means we never silently delete user-posted listings when
  // the catalog churns. The web side filters by slug and shows a plain
  // disclaimer if the card is missing.
  cardSlug    String
  kind        ListingKind
  // Decimal(12,2) covers values up to 9_999_999_999.99 in any single
  // currency. Stored as Decimal so frontend math (currency conversions,
  // sorting) stays accurate; tRPC 11 serialises Decimal as a string.
  price       Decimal?          @db.Decimal(12, 2)
  // ISO 4217 currency code. Defaults to CNY because the dominant audience
  // is mainland China; international users override per-listing.
  currency    String            @default("CNY")
  // Postgres text[] capped at 4 entries by zod on the api side. Cardhub
  // does not host its own image pipeline yet (see backlog) so urls must
  // be external — typically an image host or a card scan.
  imageUrls   String[]          @default([])
  contact     String
  note        String?
  condition   ListingCondition?
  language    ListingLanguage?
  variantNote String?
  status      ListingStatus     @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardSlug])
  @@index([status, createdAt])
  @@index([status, currency, price])
  @@map("listings")
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  // Polymorphic pointer: (targetType, targetId). We do not enforce
  // referential integrity with a FK because the target spans four tables;
  // the admin queue surfaces orphaned rows cleanly enough for mvp.
  targetType   ReportTargetType
  targetId     String
  reason       String
  status       ReportStatus     @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  createdAt    DateTime         @default(now())

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([resolvedById])
  @@map("reports")
}

// Append-only moderation record. Old servers ignore the table.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorUsername String
  action        String
  targetType    String
  targetId      String
  targetLabel   String
  targetUserId  String?
  reason        String?
  createdAt     DateTime @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// One row per user per UTC calendar day. Written from an authenticated tRPC
// request. Stores no IP, user agent, email, or username. Old servers ignore
// the table. Expand-only: do not drop it while this version is still running.
model UserDailyActivity {
  id        String   @id @default(uuid())
  userId    String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("user_daily_activities")
}
