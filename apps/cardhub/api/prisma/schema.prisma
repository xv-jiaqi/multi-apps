generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  // role: "user" | "admin". Admins can delete any topic / reply / listing /
  // comment and view the moderation report queue. Stored as a free-form
  // string instead of an enum so future roles ("mod", "banned") don't need a
  // schema migration just to be added.
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  topics   Topic[]
  replies  Reply[]
  listings Listing[]
  reports  Report[]

  @@map("users")
}

model Series {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards Card[]

  @@map("series")
}

model Card {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  rarity      String?
  attributes  Json?
  seriesId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([seriesId])
  @@index([name])
  @@map("cards")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("comments")
}

model Topic {
  id        String   @id @default(uuid())
  // slug = slugify(title) + "-" + 6-char nanoid suffix to keep the URL stable
  // even if the author edits the title within the 5-minute window.
  slug      String   @unique
  title     String
  body      String
  userId    String
  // pinned topics float to the top of the timeline. Only admins set this in
  // M6 — there is no UI for ordinary users.
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@index([createdAt])
  @@index([userId])
  @@map("topics")
}

model Reply {
  id        String   @id @default(uuid())
  topicId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@map("replies")
}

enum ListingKind {
  SELL
  BUY
}

enum ListingStatus {
  OPEN
  CLOSED
}

enum ReportTargetType {
  LISTING
  TOPIC
  REPLY
  COMMENT
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model Listing {
  id        String        @id @default(uuid())
  userId    String
  // cardSlug is stored as a string instead of a Card relation because a
  // listing may reference a card slug that was reseeded / renamed; keeping
  // the link soft means we never silently delete user-posted listings when
  // the catalog churns. The web side filters by slug and shows a plain
  // disclaimer if the card is missing.
  cardSlug  String
  kind      ListingKind
  // Decimal(12,2) covers values up to 9_999_999_999.99 in any single
  // currency. Stored as Decimal so frontend math (currency conversions,
  // sorting) stays accurate; tRPC 11 serialises Decimal as a string.
  price     Decimal?      @db.Decimal(12, 2)
  // ISO 4217 currency code. Defaults to CNY because the dominant audience
  // is mainland China; international users override per-listing.
  currency  String        @default("CNY")
  // Postgres text[] capped at 4 entries by zod on the api side. Cardhub
  // does not host its own image pipeline yet (see backlog) so urls must
  // be external — typically an image host or a card scan.
  imageUrls String[]      @default([])
  contact   String
  note      String?
  status    ListingStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardSlug])
  @@index([status, createdAt])
  @@map("listings")
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String
  // Polymorphic pointer: (targetType, targetId). We do not enforce
  // referential integrity with a FK because the target spans four tables;
  // the admin queue surfaces orphaned rows cleanly enough for mvp.
  targetType  ReportTargetType
  targetId    String
  reason      String
  status      ReportStatus     @default(PENDING)
  createdAt   DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@map("reports")
}
