# Defaults for local dev; vite picks up .env.development first.
#
# Docker/Web runtime config is intentionally NOT a Vite env var. Set container
# runtime env TRPC_URL to a full API URL ending in /trpc, e.g.:
#   prod:    TRPC_URL=https://api.card-hub.app/trpc
#   staging: TRPC_URL=https://api-staging.card-hub.app/trpc
# The nginx entrypoint writes /config.js before the app bundle boots. When
# TRPC_URL is unset, browser builds fall back to same-origin /trpc.

# Legacy build-time fallback for non-container hosting only. Leave empty for
# Docker images so the bundle contains no hard-coded API address.
VITE_TRPC_URL=

# Tauri desktop / mobile → must be absolute (custom protocol cannot use
# vite proxy). For Android emulator dev see lib/trpc.tsx auto-routing to
# http://10.0.2.2:4000/trpc.
VITE_TRPC_URL_TAURI=http://localhost:4000/trpc

# Sentry frontend DSN. Leave blank in dev to skip initialisation entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
