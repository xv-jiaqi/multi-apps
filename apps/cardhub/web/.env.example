# Defaults for local dev; vite picks up .env.development first. See
# .env.staging / .env.production for the corresponding deploy modes.

# Browser dev → leave empty so vite proxy /trpc → http://localhost:4000.
# Browser prod → set to absolute URL of the deployed API.
VITE_TRPC_URL=

# Tauri desktop / mobile → must be absolute (custom protocol cannot use
# vite proxy). For Android emulator dev see lib/trpc.tsx auto-routing to
# http://10.0.2.2:4000/trpc.
VITE_TRPC_URL_TAURI=http://localhost:4000/trpc

# Sentry frontend DSN. Leave blank in dev to skip initialisation entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
