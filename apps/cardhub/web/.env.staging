# Built via `pnpm --filter @cardhub/web build --mode staging`.
# Used by Tauri staging bundles and any QA / preview environment that points
# at the same Render API as production but has separate observability tags.
VITE_TRPC_URL=https://cardhub-api.onrender.com/trpc
VITE_TRPC_URL_TAURI=https://cardhub-api.onrender.com/trpc
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
