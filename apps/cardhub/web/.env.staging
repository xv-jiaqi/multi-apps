# Built via `pnpm --filter @cardhub/web build --mode staging`.
# Docker deploys read runtime TRPC_URL from /config.js, generated by the nginx
# entrypoint. Leave VITE_TRPC_URL empty so one image works for staging/prod.
VITE_TRPC_URL=
VITE_TRPC_URL_TAURI=https://api-staging.card-hub.app/trpc
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
