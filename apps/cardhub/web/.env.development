# Vite injects this when `pnpm --filter @cardhub/web dev` runs (default mode).
# Leave VITE_TRPC_URL empty so the browser uses the relative `/trpc` path that
# vite.config.ts proxies to http://localhost:4000.
VITE_TRPC_URL=

# Tauri desktop in dev still talks to the local API directly because the
# WebView origin is `tauri://localhost`, which the vite proxy cannot serve.
VITE_TRPC_URL_TAURI=http://localhost:4000/trpc

# Sentry stays disabled in development. Set VITE_SENTRY_DSN locally only when
# debugging the Sentry pipeline itself.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
