{
  "name": "@cardhub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cardhub Web frontend (Vite + React 19 + shadcn/ui + MobX + SWR + tRPC).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && pnpm check:brand-css && pnpm check:page-gutter-css",
    "check:brand-css": "node scripts/check-brand-css.mjs",
    "check:page-gutter-css": "node scripts/check-page-gutter-css.mjs",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/design-tokens": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/stores": "workspace:*",
    "@repo/trpc-contract": "workspace:*",
    "@repo/ui-web": "workspace:*",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-query": "^5.99.2",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "lucide-react": "^1.8.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@repo/config-ts": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "4.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.5"
  }
}
