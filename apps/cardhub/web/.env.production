# Built via `pnpm --filter @cardhub/web build` (default production mode).
# Replace cardhub-api.onrender.com with your own custom domain once configured.
VITE_TRPC_URL=https://cardhub-api.onrender.com/trpc
VITE_TRPC_URL_TAURI=https://cardhub-api.onrender.com/trpc

# Production Sentry DSN — fill in the real DSN from sentry.io project settings.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
