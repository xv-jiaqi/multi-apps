# Built via `pnpm --filter @cardhub/web build` (default production mode).
# Docker deploys read runtime TRPC_URL from /config.js, generated by the nginx
# entrypoint. Leave VITE_TRPC_URL empty so the bundle has no hard-coded API URL.
VITE_TRPC_URL=
VITE_TRPC_URL_TAURI=

# Production Sentry DSN — fill in the real DSN from sentry.io project settings.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
