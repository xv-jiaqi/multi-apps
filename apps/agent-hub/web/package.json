{
  "name": "@agent-hub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Hub 界面：Vite 8 + React 19。",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @agent-hub/contract run build",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @agent-hub/contract run build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @agent-hub/contract run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-hub/contract": "workspace:*",
    "@repo/design-tokens": "workspace:*",
    "@repo/ui-web": "workspace:*",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@repo/config-ts": "workspace:*",
    "@tailwindcss/vite": "^4.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
