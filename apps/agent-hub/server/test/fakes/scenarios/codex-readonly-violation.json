{
  "name": "codex-readonly-violation",
  "protocol": "codex",
  "exitOnStdinClose": true,
  "always": {
    "account/read": {
      "account": {
        "type": "apiKey"
      },
      "requiresOpenaiAuth": false
    },
    "model/list": {
      "data": [
        {
          "id": "gpt-5.1-codex",
          "model": "gpt-5.1-codex",
          "displayName": "GPT-5.1 Codex",
          "description": "fake",
          "hidden": false,
          "supportedReasoningEfforts": [
            {
              "reasoningEffort": "medium",
              "description": "medium"
            },
            {
              "reasoningEffort": "high",
              "description": "high"
            }
          ],
          "defaultReasoningEffort": "medium",
          "isDefault": true
        }
      ],
      "nextCursor": null
    },
    "thread/unsubscribe": {
      "status": "unsubscribed"
    },
    "turn/interrupt": {}
  },
  "steps": [
    {
      "expect": "initialize",
      "reply": {
        "userAgent": "agent_hub/0.164.0 (fake; x86_64) fake (agent_hub; 0.1.0)",
        "platformFamily": "unix",
        "platformOs": "linux"
      }
    },
    {
      "expect": "thread/start",
      "match": {
        "sandbox": "read-only",
        "approvalPolicy": "on-request"
      },
      "reply": {
        "thread": {
          "id": "thread_fake_1",
          "model": "gpt-5.1-codex",
          "reasoningEffort": null
        },
        "model": "gpt-5.1-codex",
        "reasoningEffort": null
      }
    },
    {
      "expect": "turn/start",
      "match": {
        "sandboxPolicy": {
          "type": "readOnly",
          "networkAccess": false
        }
      },
      "reply": {
        "turn": {
          "id": "turn_fake_1",
          "status": "inProgress",
          "error": null
        }
      }
    },
    {
      "notify": "turn/started",
      "params": {
        "threadId": "thread_fake_1",
        "turn": {
          "id": "turn_fake_1",
          "status": "inProgress",
          "error": null
        }
      }
    },
    {
      "request": "item/fileChange/requestApproval",
      "params": {
        "threadId": "thread_fake_1",
        "turnId": "turn_fake_1",
        "itemId": "fc_1",
        "reason": "想写一份笔记"
      },
      "writeFileIfAccepted": "NOTES.md",
      "content": "agent wrote this\n"
    },
    {
      "writeFile": "OOPS.txt",
      "content": "sandbox escape simulated\n"
    },
    {
      "notify": "item/agentMessage/delta",
      "params": {
        "threadId": "thread_fake_1",
        "turnId": "turn_fake_1",
        "itemId": "msg_1",
        "delta": "写了一个文件。"
      }
    },
    {
      "notify": "turn/completed",
      "params": {
        "threadId": "thread_fake_1",
        "turn": {
          "id": "turn_fake_1",
          "status": "completed",
          "error": null
        }
      }
    }
  ]
}
