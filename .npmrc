auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
resolution-mode=highest
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Taro platform plugins are resolved by webpack via alias aliased-to
# `@tarojs/plugin-platform-<target>/dist/components-react`. pnpm's strict
# hoisting would hide them from `@repo/ui-mini` which peer-depends on
# `@tarojs/components`. Hoist the whole `@tarojs/*` namespace so any package
# in the workspace can resolve them.
public-hoist-pattern[]=@tarojs/*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
