# GET/HEAD may be retried for a few seconds. Dial errors bypass lb_retry_match
# and are retried for every method while lb_try_duration is non-zero, so any
# other method (including tRPC POST mutations) is a separate proxy with
# retries disabled.
(cardhub_upstream) {
	@cardhub_read method GET HEAD
	reverse_proxy @cardhub_read {args[0]} {
		lb_try_duration 5s
		lb_try_interval 250ms
		lb_retry_match {
			method GET HEAD
		}
	}
	reverse_proxy {args[0]} {
		lb_try_duration 0s
	}
}

# Security headers are set here, not in the web image. nginx only sets cache
# headers. defer overwrites the same field from upstream (API helmet included).
# HSTS has no preload. Web CSP is only frame-ancestors.
(cardhub_web_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		defer
	}
}

(cardhub_api_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		defer
	}
}

import optional/root-web.caddy

{$API_DOMAIN} {
	import cardhub_api_headers
	import cardhub_upstream {$ENV_NAME}-api:4000
}

{$STAGING_WEB_DOMAIN} {
	import cardhub_web_headers
	import cardhub_upstream staging-web:8080
}

{$STAGING_API_DOMAIN} {
	import cardhub_api_headers
	import cardhub_upstream staging-api:4000
}
