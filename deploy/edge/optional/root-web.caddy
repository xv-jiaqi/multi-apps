{$ROOT_WEB_DOMAINS:http://root-web-disabled.invalid} {
	import cardhub_access_log
	import cardhub_web_headers
	import cardhub_sitemap {$ENV_NAME}-api:4000
	handle {
		import cardhub_upstream {$ENV_NAME}-web:8080
	}
}

{$ROOT_WEB_REDIRECT_DOMAINS:http://root-web-redirect-disabled.invalid} {
	import cardhub_access_log
	import cardhub_web_headers
	redir https://{$ROOT_WEB_REDIRECT_TARGET:card-hub.app}{uri} 308
}
