NODE_ENV=production
ENV_NAME=
DATABASE_URL=postgresql://cardhub:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef@postgres:5432/cardhub_prod?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://card-hub.app

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

WEB_DOMAIN=card-hub.app
API_DOMAIN=api.card-hub.app
STAGING_WEB_DOMAIN=staging.card-hub.app
STAGING_API_DOMAIN=api-staging.card-hub.app
TRPC_URL=https://api.card-hub.app/trpc
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Leave empty for normal deploys. Run the catalog seed manually once during the
# first deploy; see deploy/README.md.
CATALOG_SEED_CMD=

POSTGRES_USER=cardhub
# Must match the password embedded in DATABASE_URL. Use URL-safe hex, e.g.
# `openssl rand -hex 32`.
POSTGRES_PASSWORD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
POSTGRES_DB=cardhub_prod

# Staging env file differences:
# ENV_NAME=staging
# DATABASE_URL=postgresql://cardhub:<same-url-safe-hex-as-POSTGRES_PASSWORD>@postgres:5432/cardhub_staging?schema=public
# CORS_ORIGIN=https://staging.card-hub.app
# WEB_DOMAIN=staging.card-hub.app
# API_DOMAIN=api-staging.card-hub.app
# TRPC_URL=https://api-staging.card-hub.app/trpc
# POSTGRES_DB=cardhub_staging
# Staging also uses the same one-time catalog seed. Test accounts are created
# manually by ops with random passwords; do not run seed-demo on staging.
