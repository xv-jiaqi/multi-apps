NODE_ENV=production
DEPLOY_ENV=production
DATABASE_URL=postgresql://cardhub:change-me-postgres-password@postgres:5432/cardhub?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://cardhub.example.com,https://app.cardhub.example.com

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

WEB_DOMAIN=cardhub.example.com
API_DOMAIN=api.cardhub.example.com
STAGING_WEB_DOMAIN=staging.cardhub.example.com
STAGING_API_DOMAIN=api.staging.cardhub.example.com
TRPC_URL=https://api.cardhub.example.com/trpc
IMAGE_TAG=main

POSTGRES_USER=cardhub
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=cardhub
