NODE_ENV=production
ENV_NAME=
# Pre-switch defaults. DATABASE_URL is the admin superuser. Leave
# MIGRATE_DATABASE_URL empty so the one-shot migrate container falls back to
# DATABASE_URL. After deploy/db/split-roles.sql, switch to the commented
# values. Passwords are lowercase hex from `openssl rand -hex 32`. Never commit
# real values. Copying the post-switch URLs before the roles exist makes the
# API fail authentication and makes backups fail.
DATABASE_URL=postgresql://cardhub:replace-with-admin-password@postgres:5432/cardhub_prod?schema=public
# DATABASE_URL=postgresql://cardhub_runtime:<runtime-password>@postgres:5432/cardhub_prod?schema=public
# Schema owner, one-shot migrate container only. Empty falls back to DATABASE_URL.
MIGRATE_DATABASE_URL=
# MIGRATE_DATABASE_URL=postgresql://cardhub_migrator:<migrator-password>@postgres:5432/cardhub_prod?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
# X-Cache is off in production. Staging sets ENV_NAME=staging and
# CATALOG_CACHE_HEADER=true. Any other value keeps the header off.
CATALOG_CACHE_HEADER=

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
# Only the exact string true enables pre-hashed password writes. Any other
# value is off. Deploy overwrites this key from the GitHub Environment
# variable PASSWORD_PREHASH_WRITE when that variable is true or false.
# An unset variable leaves the line already in the server env file.
PASSWORD_PREHASH_WRITE=false
CORS_ORIGIN=https://card-hub.app

SENTRY_DSN=
# Browser DSN. Deploy overwrites this key from the GitHub Environment secret
# WEB_SENTRY_DSN when that secret is a non-empty http(s) URL. An unset secret
# leaves the line already on the server. Empty disables browser events.
WEB_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# API pino level: fatal, error, warn, info, debug, trace, or silent.
# Unset or invalid falls back to info. The api service lists LOG_LEVEL, so
# this value is injected into the container.
LOG_LEVEL=info

WEB_DOMAIN=card-hub.app
# Sitemap <loc> and robots.txt Sitemap line. No path or trailing slash.
# Empty uses https://WEB_DOMAIN. WEB_DOMAIN must be set; compose fails when it
# is missing or empty, instead of rendering https://.
PUBLIC_WEB_ORIGIN=
# Edge-only: apex serves the app; www permanently redirects to the apex.
ROOT_WEB_DOMAINS=card-hub.app
ROOT_WEB_REDIRECT_DOMAINS=www.card-hub.app
ROOT_WEB_REDIRECT_TARGET=card-hub.app
API_DOMAIN=api.card-hub.app
STAGING_WEB_DOMAIN=staging.card-hub.app
STAGING_API_DOMAIN=api-staging.card-hub.app
TRPC_URL=https://api.card-hub.app/trpc
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Leave empty for normal deploys. Run the catalog seed manually once during the
# first deploy; see deploy/README.md.
CATALOG_SEED_CMD=

# Backup script only: off-site OSS credentials live in a separate 0600 file,
# not in this app env. Default: /opt/cardhub/backups/offsite.env. Set
# OFFSITE_ENV_FILE in the backup cron only if using a different path.

# Admin superuser. Initializes the data directory and is used for restore and
# emergency admin. The API must not use this role. Rotate it only at the end of
# deploy/db/README.md, after no application session still connects as this user.
POSTGRES_USER=cardhub
POSTGRES_PASSWORD=replace-with-admin-password
POSTGRES_DB=cardhub_prod

# pg_dump role (SELECT only). Leave both empty until the role split; backup.sh
# then uses POSTGRES_USER. After the split, uncomment the backup role.
PGDUMP_USER=
PGDUMP_PASSWORD=
# PGDUMP_USER=cardhub_backup
# PGDUMP_PASSWORD=<backup-password>

# Staging env file differences (pre-switch):
# ENV_NAME=staging
# CATALOG_CACHE_HEADER=true
# DATABASE_URL=postgresql://cardhub:<admin-password>@postgres:5432/cardhub_staging?schema=public
# MIGRATE_DATABASE_URL=
# CORS_ORIGIN=https://staging.card-hub.app
# WEB_DOMAIN=staging.card-hub.app
# PUBLIC_WEB_ORIGIN=  (empty; compose uses https://staging.card-hub.app)
# API_DOMAIN=api-staging.card-hub.app
# WEB_SENTRY_DSN=  (written from the staging GitHub Environment secret when set)
# SENTRY_ENVIRONMENT=staging
# TRPC_URL=https://api-staging.card-hub.app/trpc
# POSTGRES_DB=cardhub_staging
# PGDUMP_USER=
# PGDUMP_PASSWORD=
# After the role split:
# DATABASE_URL=postgresql://cardhub_runtime:<runtime-password>@postgres:5432/cardhub_staging?schema=public
# MIGRATE_DATABASE_URL=postgresql://cardhub_migrator:<migrator-password>@postgres:5432/cardhub_staging?schema=public
# PGDUMP_USER=cardhub_backup
# PGDUMP_PASSWORD=<backup-password>
# Staging also uses the same one-time catalog seed. Test accounts are created
# manually by ops with random passwords; do not run seed-demo on staging.
