{
  "name": "multi-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for personal multi-platform apps (Cardhub and more). Turborepo + PNPM + Tauri + NestJS/tRPC.",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cardhub/web --filter=@cardhub/api",
    "dev:web": "pnpm --filter @cardhub/web --fail-if-no-match exec pnpm run dev",
    "dev:api": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run dev",
    "dev:native": "pnpm --filter @cardhub/native --fail-if-no-match exec pnpm run dev",
    "dev:miniapp": "pnpm --filter @cardhub/miniapp --fail-if-no-match exec pnpm run dev",
    "dev:miniapp:h5": "pnpm --filter @cardhub/miniapp --fail-if-no-match exec pnpm run dev:h5",
    "dev:miniapp:alipay": "pnpm --filter @cardhub/miniapp --fail-if-no-match exec pnpm run dev:alipay",
    "dev:packages": "turbo run dev --filter=./packages/*",
    "build": "turbo run build --filter=!@cardhub/native",
    "lint": "pnpm check:tailwind-grid && eslint .",
    "check:tailwind-grid": "node scripts/check-tailwind-arbitrary-grid.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run db:generate",
    "db:migrate": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run db:migrate",
    "seed:catalog": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run seed:catalog",
    "seed:demo": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run seed:demo",
    "db:studio": "pnpm --filter @cardhub/api --fail-if-no-match exec pnpm run db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@repo/config-eslint": "workspace:*",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
