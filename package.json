{
  "name": "multi-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for personal multi-platform apps (Cardhub and more). Turborepo + PNPM + Tauri + NestJS/tRPC.",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cardhub/web --filter=@cardhub/api",
    "dev:web": "pnpm --filter @cardhub/web dev",
    "dev:api": "pnpm --filter @cardhub/api dev",
    "dev:native": "pnpm --filter @cardhub/native dev",
    "dev:miniapp": "pnpm --filter @cardhub/miniapp dev",
    "dev:miniapp:h5": "pnpm --filter @cardhub/miniapp dev:h5",
    "dev:miniapp:alipay": "pnpm --filter @cardhub/miniapp dev:alipay",
    "dev:packages": "turbo run dev --filter=./packages/*",
    "build": "turbo run build --filter=!@cardhub/native",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @cardhub/api db:generate",
    "db:migrate": "pnpm --filter @cardhub/api db:migrate",
    "db:studio": "pnpm --filter @cardhub/api db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@repo/config-eslint": "workspace:*",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
