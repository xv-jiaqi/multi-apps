# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.nest/
.turbo/
*.tsbuildinfo

# Env files — only secrets-bearing files are ignored. Vite mode templates
# (.env.development / .env.staging / .env.production) are checked in because
# they only contain non-secret URLs and feature flags.
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.staging
!.env.production

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Other AI agent / IDE workspaces (Iflow, Junie, Qoder, Cursor agents folder)
.agents/
.iflow/
.junie/
.qoder/

# Tauri
apps/**/src-tauri/target/
apps/**/src-tauri/gen/

# Taro
apps/**/miniapp/dist/
apps/**/miniapp/.temp/
apps/**/miniapp/.swc/

# Prisma
apps/**/prisma/generated/
apps/**/prisma/migrations/dev/

# Coverage
coverage/
.nyc_output/

# Misc
.eslintcache
.vite/
