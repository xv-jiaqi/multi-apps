# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.nest/
.turbo/
*.tsbuildinfo

# Env files — only secrets-bearing files are ignored. Vite mode templates
# (.env.development / .env.staging / .env.production) are checked in because
# they only contain non-secret URLs and feature flags.
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.staging
!.env.production

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Other AI agent / IDE workspaces (Iflow, Junie, Qoder, Cursor agents folder)
.agents/
.iflow/
.junie/
.qoder/

# Tauri
apps/**/src-tauri/target/
# gen/ contains regenerated platform projects (Xcode + Android Studio). They
# bake absolute paths and per-developer signing data, so we ignore the whole
# tree and let `tauri ios init` / `tauri android init` recreate them on first
# checkout. See apps/cardhub/native/MOBILE_SETUP.md for the bootstrap steps.
apps/**/src-tauri/gen/
# Xcode noise — already covered by gen/ ignore but kept for clarity if a
# contributor opens the .xcworkspace at the repo root for any reason.
**/xcuserdata/
**/*.xcuserdatad/
**/.gradle/
# Cocoapods cache produced by tauri ios init / build.
**/Pods/

# Taro
apps/**/miniapp/dist/
apps/**/miniapp/.temp/
apps/**/miniapp/.swc/

# Prisma
apps/**/prisma/generated/
apps/**/prisma/migrations/dev/

# Coverage
coverage/
.nyc_output/

# Misc
.eslintcache
.vite/
