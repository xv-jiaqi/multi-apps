# Used for all `docker build -f ... .` invocations from repo root.
**/node_modules
**/.turbo
**/dist
**/build
**/.nest
**/.git
**/.DS_Store
**/coverage
**/.vscode
**/.idea
**/src-tauri/target
**/src-tauri/gen
# Never bake secrets into images; deployment injects env at runtime.
**/.env
**/.env.*
!**/.env.example
