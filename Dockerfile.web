# Production image for @cardhub/web — Vite/React SPA served by nginx.
#
# The nginx entrypoint writes /config.js from runtime environment variables so
# one immutable image can serve staging and production. Set `TRPC_URL` to the
# public API URL ending in `/trpc`; the container refuses to start when it is
# missing or invalid.
# Example local run:
#   docker run -e TRPC_URL=https://api.card-hub.app/trpc cardhub-web:latest

ARG NODE_VERSION=22-alpine
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown

############################
# Stage 1 — prune workspace to the @cardhub/web subset
############################
FROM node:${NODE_VERSION} AS pruner
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY . .
RUN pnpm dlx turbo prune @cardhub/web --docker

############################
# Stage 2 — install upstream + vite build
############################
FROM node:${NODE_VERSION} AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .

# Legacy build-time URL support remains only as a fallback for non-container
# builds. Docker deploys should use runtime TRPC_URL so this image stays
# environment-agnostic.
ARG BUILDTIME_VITE_TRPC_URL=
ARG BUILDTIME_VITE_SENTRY_DSN=
ARG BUILDTIME_VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
ENV VITE_TRPC_URL=${BUILDTIME_VITE_TRPC_URL} \
    VITE_SENTRY_DSN=${BUILDTIME_VITE_SENTRY_DSN} \
    VITE_SENTRY_TRACES_SAMPLE_RATE=${BUILDTIME_VITE_SENTRY_TRACES_SAMPLE_RATE}

# @repo/trpc-contract lists @cardhub/api as a devDependency (AppRouter types),
# so `turbo run build --filter=@cardhub/web` still schedules @cardhub/api#build.
# Prisma Client must exist before Nest/tsc can compile the API — same as
# Dockerfile.api / CI (prisma generate does not need DATABASE_URL).
RUN pnpm --filter @cardhub/api db:generate \
  && pnpm turbo run build --filter=@cardhub/web

############################
# Stage 3 — nginx serve
############################
FROM nginx:1.27-alpine AS runner
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /repo/apps/cardhub/web/nginx-spa.conf /etc/nginx/conf.d/cardhub-web.conf
COPY --from=builder /repo/apps/cardhub/web/docker-entrypoint.d/10-cardhub-runtime-config.sh /docker-entrypoint.d/10-cardhub-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/10-cardhub-runtime-config.sh

COPY --from=builder /repo/apps/cardhub/web/dist /usr/share/nginx/html

ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
LABEL org.opencontainers.image.revision=${GIT_SHA}
LABEL org.opencontainers.image.created=${BUILD_TIME}
LABEL org.opencontainers.image.source="https://github.com/xv-jiaqi/multi-apps"
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
