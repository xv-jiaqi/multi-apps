# syntax=docker/dockerfile:1.7
# Production image for @cardhub/web — Vite/React SPA served by nginx.
#
# Zeabur picks this Dockerfile when the service env has
# `ZBPACK_DOCKERFILE_NAME=web`. Build from repo root for other platforms:
#   docker build -f Dockerfile.web --build-arg VITE_TRPC_URL=https://api.example.com/trpc -t cardhub-web:latest .

ARG NODE_VERSION=22-alpine

############################
# Stage 1 — prune workspace to the @cardhub/web subset
############################
FROM node:${NODE_VERSION} AS pruner
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY . .
RUN pnpm dlx turbo prune @cardhub/web --docker

############################
# Stage 2 — install upstream + vite build
############################
FROM node:${NODE_VERSION} AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .

# These ARGs are consumed by Vite at build time. Zeabur auto-injects
# the matching service env vars; for raw `docker build` pass them via
# --build-arg. Empty values are fine (Sentry stays disabled).
ARG VITE_TRPC_URL=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
ENV VITE_TRPC_URL=${VITE_TRPC_URL} \
    VITE_SENTRY_DSN=${VITE_SENTRY_DSN} \
    VITE_SENTRY_TRACES_SAMPLE_RATE=${VITE_SENTRY_TRACES_SAMPLE_RATE}

# Build all upstream @repo/* packages first (turbo respects dependsOn:^build),
# then vite build for @cardhub/web. The `--filter ...^...` syntax includes
# every workspace package that @cardhub/web depends on.
RUN pnpm turbo run build --filter=@cardhub/web

############################
# Stage 3 — nginx serve
############################
FROM nginx:1.27-alpine AS runner
RUN rm /etc/nginx/conf.d/default.conf

# SPA fallback: any path without a file extension falls back to index.html
# so React Router v7 client routes (/series, /forum/:slug, etc.) survive
# a refresh.
COPY <<'NGINX' /etc/nginx/conf.d/cardhub-web.conf
server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Long-cache hashed assets emitted by vite.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|webp|gif|map)$ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # SPA fallback for everything else.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
NGINX

COPY --from=builder /repo/apps/cardhub/web/dist /usr/share/nginx/html

ENV PORT=8080
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
