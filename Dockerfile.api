# syntax=docker/dockerfile:1.7
# Production image for @cardhub/api.
#
# Build from the repo root explicitly:
#   docker build -f Dockerfile.api -t cardhub-api:latest .

ARG NODE_VERSION=22-alpine

############################
# Stage 1 — prune workspace
############################
FROM node:${NODE_VERSION} AS pruner
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY . .
RUN pnpm dlx turbo prune @cardhub/api --docker

############################
# Stage 2 — production dependencies
############################
FROM node:${NODE_VERSION} AS prod-deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @cardhub/api deploy --prod --legacy /app

############################
# Stage 3 — install & build
############################
FROM node:${NODE_VERSION} AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
# Build with turbo so the dependsOn:^build chain in turbo.json compiles every
# upstream @repo/* package (shared, stores, trpc-contract, ...) before the
# NestJS tsc step runs. A bare `pnpm --filter @cardhub/api build` would
# resolve `@repo/shared` to its empty `dist/` (gitignored) and fail with
# "Cannot find module '@repo/shared'".
RUN pnpm --filter @cardhub/api db:generate \
  && pnpm turbo run build --filter=@cardhub/api

############################
# Stage 4 — runtime
############################
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
RUN addgroup -S app && adduser -S app -G app
COPY --from=prod-deps --chown=app:app /app/package.json ./package.json
COPY --from=prod-deps --chown=app:app /app/node_modules ./node_modules
COPY --from=builder --chown=app:app /repo/apps/cardhub/api/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder --chown=app:app /repo/apps/cardhub/api/prisma/migrations ./prisma/migrations
RUN npx --no-install prisma generate --schema=./prisma/schema.prisma
COPY --from=builder /repo/packages/shared/dist /tmp/shared-dist
RUN shared_path="$(node -p "require('fs').realpathSync('node_modules/@repo/shared')")" \
  && mkdir -p "${shared_path}/dist" \
  && cp -R /tmp/shared-dist/. "${shared_path}/dist/" \
  && chown -R app:app "${shared_path}/dist" \
  && rm -rf /tmp/shared-dist
COPY --from=builder --chown=app:app /repo/apps/cardhub/api/dist ./dist
USER app
RUN node <<'NODE'
const fs = require('fs');
const path = require('path');

const repoScope = path.join(process.cwd(), 'node_modules', '@repo');
if (fs.existsSync(repoScope)) {
  for (const packageName of fs.readdirSync(repoScope)) {
    require(`@repo/${packageName}`);
  }
}
require('@prisma/client');
NODE
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
LABEL org.opencontainers.image.revision=${GIT_SHA}
LABEL org.opencontainers.image.created=${BUILD_TIME}
LABEL org.opencontainers.image.source="https://github.com/xv-jiaqi/multi-apps"
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
# Migrations are not part of this process. deploy/migrate-entrypoint.sh runs
# `prisma migrate deploy` in a one-shot container, which is the only process
# that receives MIGRATE_DATABASE_URL. An empty MIGRATE_DATABASE_URL falls
# back to DATABASE_URL. This command replaces the shell with node so the
# server is tini's direct child. Signal delivery still needs compose
# `init: true`: without a JS SIGTERM listener, node ignores SIGTERM when it
# is PID 1 and `docker stop` SIGKILLs it after the grace period.
COPY --chmod=555 deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
COPY --chmod=555 deploy/migrate-entrypoint.sh /usr/local/bin/migrate-entrypoint.sh
CMD ["/usr/local/bin/api-entrypoint.sh"]
