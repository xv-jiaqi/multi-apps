# syntax=docker/dockerfile:1.7
# Production image for @cardhub/api.
#
# Build from the repo root explicitly:
#   docker build -f Dockerfile.api -t cardhub-api:latest .

ARG NODE_VERSION=22-alpine
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown

############################
# Stage 1 — prune workspace
############################
FROM node:${NODE_VERSION} AS pruner
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY . .
RUN pnpm dlx turbo prune @cardhub/api --docker

############################
# Stage 2 — install & build
############################
FROM node:${NODE_VERSION} AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.18.2 --activate
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .
# Build with turbo so the dependsOn:^build chain in turbo.json compiles every
# upstream @repo/* package (shared, stores, trpc-contract, ...) before the
# NestJS tsc step runs. A bare `pnpm --filter @cardhub/api build` would
# resolve `@repo/shared` to its empty `dist/` (gitignored) and fail with
# "Cannot find module '@repo/shared'".
RUN pnpm --filter @cardhub/api db:generate \
  && pnpm turbo run build --filter=@cardhub/api \
  && pnpm --filter @cardhub/api deploy --prod --legacy /app \
  && cd /app && npx prisma generate

############################
# Stage 3 — runtime
############################
FROM node:${NODE_VERSION} AS runner
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
LABEL org.opencontainers.image.revision=${GIT_SHA}
LABEL org.opencontainers.image.created=${BUILD_TIME}
LABEL org.opencontainers.image.source="https://github.com/xv-jiaqi/multi-apps"
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder --chown=app:app /app /app
USER app
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
# `pnpm deploy` copies prod node_modules but does not carry the generated
# `.prisma/client` tree from the monorepo root; regenerate inside /app so
# `require('@prisma/client')` resolves at runtime.
# Run pending Prisma migrations on every container boot, then start Nest. We
# rely on Prisma's `migrate deploy` instead of `migrate dev` because the
# command is non-interactive (no prompt for migration name) and is safe to run
# concurrently — it acquires an advisory lock on `_prisma_migrations`.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
