{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.local", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.spec.ts"],
      "outputs": [
        "dist/**",
        "build/**",
        ".nest/**",
        "src-tauri/target/release/bundle/**",
        "src-tauri/gen/**",
        "prisma/generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRES_IN",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "CORS_ORIGIN"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["prisma/generated/**", "node_modules/.prisma/**"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "miniapp:weapp": {
      "dependsOn": ["^build"],
      "outputs": ["dist/weapp/**"]
    },
    "miniapp:alipay": {
      "dependsOn": ["^build"],
      "outputs": ["dist/alipay/**"]
    },
    "miniapp:tt": {
      "dependsOn": ["^build"],
      "outputs": ["dist/tt/**"]
    },
    "miniapp:h5": {
      "dependsOn": ["^build"],
      "outputs": ["dist/h5/**"]
    },
    "native:dev": {
      "cache": false,
      "persistent": true
    },
    "native:build": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "native:android": {
      "cache": false,
      "persistent": true
    },
    "native:ios": {
      "cache": false,
      "persistent": true
    }
  }
}
